# Canonical site URL for Open Graph / absolute metadata (optional). Example: https://yoursite.netlify.app
NEXT_PUBLIC_SITE_URL=

# Demo hub: set any flag to "0" to hide that demo or family (see lib/config/feature-flags.js).
# Empty or unset means ON. Applies at build time for static pages; restart dev server after changes.

# Family toggles (category defaults when a row has no featureFlag in content/demos.json)
NEXT_PUBLIC_DEMO_IMMERSIVE=
NEXT_PUBLIC_DEMO_AUGMENTED=
NEXT_PUBLIC_DEMO_THREE_D=
NEXT_PUBLIC_DEMO_CREATIVE=
NEXT_PUBLIC_DEMO_MOBILE=

# Per-demo override (matches featureFlag on a demos.json row, e.g. HELLO -> NEXT_PUBLIC_DEMO_HELLO)
NEXT_PUBLIC_DEMO_HELLO=
